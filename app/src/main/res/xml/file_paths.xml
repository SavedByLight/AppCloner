<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path name="cloned_apks" path="cloned_apks/" />
    <!-- CloneEngine writes each clone's APKs to cacheDir/clone_work_<pkg>/,
         not cloned_apks/ — cover the whole cache dir so FileProvider can
         grant a content:// URI for those files too (needed for the
         ACTION_VIEW third-party-installer handoff). -->
    <cache-path name="clone_work" path="." />
    <!-- Durable export location used for manual/adb fallback installs. -->
    <external-files-path name="clone_exports" path="clone_debug_export/" />
</paths>
