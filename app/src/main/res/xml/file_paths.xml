<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path name="cloned_apks" path="cloned_apks/" />
    <!-- CloneEngine writes each clone's APKs to cacheDir/clone_work_<pkg>/,
         not cloned_apks/ — this cache mapping is kept for any future sharing
         or debugging flows that need access to staged clone APKs. -->
    <cache-path name="clone_work" path="." />
</paths>
