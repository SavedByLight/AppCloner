<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:textSize="18sp"
        android:textStyle="bold"
        android:text="Firebase config"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp"
        android:textSize="14sp"
        android:text="Optionally supply a replacement google-services.json. If set, the clone engine swaps it into the cloned APK in place of the original app's Firebase config."/>

    <Button
        android:id="@+id/selectFirebaseJsonButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="4dp"
        android:text="Select Firebase config (google-services.json)"/>

    <Button
        android:id="@+id/clearFirebaseJsonButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:text="Clear Firebase config"/>

    <TextView
        android:id="@+id/currentStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:textSize="13sp"
        android:textStyle="italic"/>

</LinearLayout>
